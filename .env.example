# Скопируйте в .env и заполните значения
# Переменные читаются с префиксом COUPLE_BOT_

# ── Telegram ─────────────────────────────────────────────
COUPLE_BOT_BOT_TOKEN=123456789:AA...ваш_токен

# ── Базы данных ─────────────────────────────────────────
# Локальная разработка на SQLite (раскомментируйте одну строку):
# COUPLE_BOT_POSTGRES_DSN=sqlite+aiosqlite:///./dev.db
# Продакшн на PostgreSQL (по умолчанию):
COUPLE_BOT_POSTGRES_DSN=postgresql+asyncpg://couple:couple@localhost:5432/couple_bot
COUPLE_BOT_REDIS_DSN=redis://localhost:6379/0

# ── Режим работы ────────────────────────────────────────
COUPLE_BOT_DEBUG=false
COUPLE_BOT_WEBHOOK_ENABLED=false
COUPLE_BOT_WEBHOOK_URL=https://your.domain
COUPLE_BOT_WEBHOOK_PATH=/webhook
COUPLE_BOT_WEBHOOK_HOST=0.0.0.0
COUPLE_BOT_WEBHOOK_PORT=8443

# ── Логирование ─────────────────────────────────────────
COUPLE_BOT_LOG_LEVEL=INFO
COUPLE_BOT_LOG_FILE=logs/couple_bot.log

# ── Локализация / часовой пояс ──────────────────────────
COUPLE_BOT_DEFAULT_TIMEZONE=Europe/Moscow
COUPLE_BOT_DEFAULT_LANGUAGE=ru
COUPLE_BOT_SCHEDULER_TIMEZONE=UTC

# ── Антиспам ────────────────────────────────────────────
COUPLE_BOT_THROTTLE_RATE=0.5

# ── Админы (список user_id через запятую) ───────────────
COUPLE_BOT_ADMINS=[]

# ── Бэкапы (S3-совместимое хранилище) ──────────────────
COUPLE_BOT_BACKUP_ENABLED=false
COUPLE_BOT_S3_ENDPOINT=https://s3.example.com
COUPLE_BOT_S3_ACCESS_KEY=
COUPLE_BOT_S3_SECRET_KEY=
COUPLE_BOT_S3_BUCKET=couple-bot-backups
